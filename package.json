{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "audit": "npm audit --audit-level=critical || true",
    "test": "tsx tests/run-all.ts",
    "test:watch": "tsx watch tests/run-all.ts",
    "test:auth": "tsx test-auth.ts",
    "test:rules": "tsx test-rules.ts",
    "test:retention": "tsx test-retention.ts",
    "test:limits": "tsx test-methodology-limits.ts",
    "test:a11y": "tsx test-wcag-accessibility.ts",
    "test:metadata": "tsx test-metadata-first-render.ts",
    "test:billing": "tsx test-billing-firestore.ts",
    "test:webhook": "tsx test-webhook-security.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {},
  "overrides": {
    "postcss": "^8.5.3",
    "nanoid": "^3.3.18",
    "uuid": "^11.1.1"
  }
}
